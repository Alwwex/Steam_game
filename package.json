{
  "name": "qubit-crew",
  "productName": "Qubit Crew",
  "version": "0.1.0",
  "description": "Qubit Crew - a co-op game about cats, flashlights and a broken quantum computer",
  "main": "electron/main.js",
  "private": true,
  "author": "Qubit Crew Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node tools/build.js",
    "build:dev": "node tools/build.js --dev",
    "watch": "node tools/build.js --watch",
    "start": "npm run build && electron .",
    "dev": "node tools/build.js --dev && node tools/dev-server.js",
    "server": "node server/relay.js",
    "test": "node tools/build.js --dev && node tools/test-all.js all",
    "dist:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:linux": "npm run build && electron-builder --linux --x64 --dir",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "steam:stage": "node tools/stage-steam.js",
    "store:assets": "node tools/build.js --dev --preview && node tools/store-assets.js"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  },
  "build": {
    "appId": "com.qubitcrew.game",
    "productName": "Qubit Crew",
    "executableName": "QubitCrew",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/index.html",
      "app/style.css",
      "app/game.js",
      "electron/**",
      "server/**",
      "steam_config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "electronLanguages": [
      "en-US",
      "cs"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png",
      "extraFiles": [
        {
          "from": "node_modules/steamworks.js/dist/win64/steam_api64.dll",
          "to": "steam_api64.dll"
        },
        {
          "from": "THIRD_PARTY_NOTICES.txt",
          "to": "THIRD_PARTY_NOTICES.txt"
        }
      ]
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Game",
      "extraFiles": [
        {
          "from": "node_modules/steamworks.js/dist/linux64/libsteam_api.so",
          "to": "libsteam_api.so"
        },
        {
          "from": "THIRD_PARTY_NOTICES.txt",
          "to": "THIRD_PARTY_NOTICES.txt"
        }
      ]
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "extraFiles": [
        {
          "from": "node_modules/steamworks.js/dist/osx/libsteam_api.dylib",
          "to": "MacOS/libsteam_api.dylib"
        },
        {
          "from": "THIRD_PARTY_NOTICES.txt",
          "to": "Resources/THIRD_PARTY_NOTICES.txt"
        }
      ]
    },
    "publish": null
  }
}
